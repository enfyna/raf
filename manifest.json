{
  "manifest_version": 3,

  "name": "RAF - RetroAchievements Favorite Achievements",
  "description": "Shows your favorite 3 achievements next to your profile header.",
  "version": "1.2",

  "icons": {
    "48": "icons/medal.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "raf@enfyna",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["https://retroachievements.org/achievement/*"],
      "js": ["src/achievement.js"]
    },
    {
      "matches": ["https://retroachievements.org/user/*"],
      "js": ["src/user.js"]
    }
  ]
}
